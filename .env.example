# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to True when TLS is terminated by a proxy in front of the app.
DJANGO_BEHIND_HTTPS_PROXY=False
# Per-IP rate limit for register, login, and token refresh.
DJANGO_AUTH_THROTTLE_RATE=10/minute
# Trusted reverse proxies in front of Django (production Compose sets 1).
DJANGO_NUM_PROXIES=0
BOT_INTERNAL_SECRET=


# PostgreSQL
POSTGRES_DB=ludora_store
POSTGRES_USER=ludora_store
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# Celery
CELERY_BROKER_URL=redis://redis:6379/0


# Email (console output is the safe local default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Ludora <noreply@localhost>


# Payments (local is the safe development default)
PAYMENT_PROVIDER=local
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=


# Telegram bot
BOT_TOKEN=
BOT_BACKEND_BASE_URL=http://backend:8000
BOT_API_TIMEOUT=5
BOT_DEFAULT_LANGUAGE=en
